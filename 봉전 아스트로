local function fmtTime(s)
	return string.format("%02d:%02d", math.floor(s / 60), math.floor(s % 60))
end

local function setStatus(line1, line2)
	if ui.status then ui.status.Text = line1 end
	if ui.stats and line2 then ui.stats.Text = line2 end
end

local function getCharacter()
	local char = player.Character
	if not char then return nil end
	local hrp, hum = char:FindFirstChild("HumanoidRootPart"), char:FindFirstChildOfClass("Humanoid")
	if hrp and hum and hum.Health > 0 then return char, hrp, hum end
	return nil
end

local function flyTo(target, isActive, instant)
	local _, hrp, hum = getCharacter()
	if not hrp then return false end

	if instant then
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.CFrame = CFrame.new(target) * hrp.CFrame.Rotation
		return true
	end

	while isActive() do
		local dt = RunService.Heartbeat:Wait()
		if not isActive() or not hrp.Parent or hum.Health <= 0 then return false end
		local offset = target - hrp.Position
		local dist = offset.Magnitude
		if dist <= CONFIG.ArriveDistance then
			hrp.CFrame = CFrame.new(target) * hrp.CFrame.Rotation
			return true
		end
		local newPos = hrp.Position + offset.Unit * math.min(CONFIG.Speed * dt, dist)
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.CFrame = CFrame.new(newPos) * hrp.CFrame.Rotation
	end
	return false
end

