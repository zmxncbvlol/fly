do
	local dragging, dragStart, startPos = false, nil, nil
	local draggingSlider = false

	local function setSpeedFromX(x)
		local rel = (x - sliderTrack.AbsolutePosition.X) / sliderTrack.AbsoluteSize.X
		rel = math.clamp(rel, 0, 1)
		CONFIG.Speed = math.floor(CONFIG.MinSpeed + rel * (CONFIG.MaxSpeed - CONFIG.MinSpeed))
		refreshButtons()
		updateSliderVisual()
	end

	local function isPress(input)
		return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
	end

	title.InputBegan:Connect(function(input)
		if isPress(input) then dragging, dragStart, startPos = true, input.Position, main.Position end
	end)
	sliderTrack.InputBegan:Connect(function(input)
		if isPress(input) then draggingSlider = true setSpeedFromX(input.Position.X) end
	end)
	sliderKnob.InputBegan:Connect(function(input)
		if isPress(input) then draggingSlider = true end
	end)

	UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		elseif draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setSpeedFromX(input.Position.X)
		end
	end)
	UIS.InputEnded:Connect(function(input)
		if isPress(input) then dragging, draggingSlider = false, false end
	end)
end