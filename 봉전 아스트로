end

local function applyTheme(name)
	local th = THEMES[name]
	CONFIG.Theme = name
	local ti = TweenInfo.new(0.25)
	TS:Create(main, ti, { BackgroundColor3 = th.bg1 }):Play()
	TS:Create(stroke, ti, { Color = th.accent }):Play()
	bgGradient.Color = ColorSequence.new(th.bg1, th.bg2)
	TS:Create(title, ti, { BackgroundColor3 = th.header }):Play()
	TS:Create(footer, ti, { BackgroundColor3 = th.footer }):Play()
	TS:Create(glow1, ti, { BackgroundColor3 = th.accent }):Play()
	TS:Create(glow2, ti, { BackgroundColor3 = th.accent2 }):Play()
	TS:Create(accentBar, ti, { BackgroundColor3 = th.accent }):Play()
	titleText.TextColor3 = th.text
	subTitleText.TextColor3 = th.subtext
	footerText.TextColor3 = th.subtext
	TS:Create(speedPanel, ti, { BackgroundColor3 = th.panel }):Play()
	TS:Create(statusPanel, ti, { BackgroundColor3 = th.panel2 }):Play()
	ui.status.TextColor3 = th.text
	ui.stats.TextColor3 = th.subtext
	ui.speedLabel.TextColor3 = th.subtext
	ui.speedValue.TextColor3 = th.accent
	sliderFill.BackgroundColor3 = th.accent
	progFill.BackgroundColor3 = th.accent
	TS:Create(centerBtn, ti, { BackgroundColor3 = th.accent }):Play()
	themeBtn.Text = name == "Dark" and "◐" or "◑"
	refreshButtons()
	updateStatusDotColor()
end

