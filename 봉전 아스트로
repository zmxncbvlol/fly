local function make(class, props, parent)
	local inst = Instance.new(class)
	for k, v in pairs(props) do inst[k] = v end
	inst.Parent = parent
	return inst
end

local function corner(r, parent) make("UICorner", { CornerRadius = UDim.new(0, r or 8) }, parent) end

local function iconDot(parent, color, size)
	local d = make("Frame", {
		Size = UDim2.new(0, size or 8, 0, size or 8),
		BackgroundColor3 = color, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 0.5),
	}, parent)
	corner((size or 8) / 2, d)
	return d
end

-- 아이콘 + 텍스트 버튼. 아이콘은 도형으로 그리고, 원형 배지 배경을 둠
local function iconButton(iconType, text, pos, size, color, parent, fontSize)
	local b = make("TextButton", {
		Size = size, Position = pos, BackgroundColor3 = color, BorderSizePixel = 0,
		Font = Enum.Font.GothamBold, Text = "", TextColor3 = Color3.new(1, 1, 1), TextSize = fontSize or 14,
		AutoButtonColor = false,
	}, parent)
	corner(10, b)
	make("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.new(1,1,1), color),
		Transparency = NumberSequence.new{ NumberSequenceKeypoint.new(0, 0.82), NumberSequenceKeypoint.new(1, 1) } }, b)

	local badge = make("Frame", {
		Size = UDim2.new(0, 30, 0, 30), Position = UDim2.new(0, 8, 0.5, -15),
		BackgroundColor3 = Color3.new(1,1,1), BackgroundTransparency = 0.85, BorderSizePixel = 0,
	}, b)
	corner(15, badge)

	local iconHolder = make("Frame", {
		Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(0.5, -8, 0.5, -8), BackgroundTransparency = 1,
	}, badge)

	if iconType == "play" then
		local tri = make("Frame", { Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(0.5, -4, 0.5, -6),
			Rotation = 45, BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0 }, iconHolder)
		corner(2, tri)
		make("Frame", { Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(0, -8, 0, 0),
			BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = 2 }, iconHolder)
	elseif iconType == "stop" then
		local sq = make("Frame", { Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(0.5, -6, 0.5, -6),
			BackgroundColor3 = Color3.new(1,1,1), BorderSizePixel = 0 }, iconHolder)
		corner(3, sq)
	elseif iconType == "target" then
		local ring = make("Frame", { Size = UDim2.new(0, 16, 0, 16), BackgroundTransparency = 1 }, iconHolder)
		make("UIStroke", { Thickness = 2, Color = Color3.new(1,1,1) }, ring)
		corner(8, ring)
		local dot = iconDot(ring, Color3.new(1,1,1), 5)
		dot.AnchorPoint = Vector2.new(0.5, 0.5)
		dot.Position = UDim2.new(0.5, 0, 0.5, 0)
	end

	local label = make("TextLabel", {
		Size = UDim2.new(1, -54, 1, 0), Position = UDim2.new(0, 50, 0, 0), BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold, Text = text, TextColor3 = Color3.new(1,1,1), TextSize = fontSize or 14,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, b)

	b.MouseEnter:Connect(function()
		TS:Create(b, TweenInfo.new(0.12), { BackgroundColor3 = color:Lerp(Color3.new(1,1,1), 0.18) }):Play()
	end)
	b.MouseLeave:Connect(function()
		TS:Create(b, TweenInfo.new(0.12), { BackgroundColor3 = color }):Play()
	end)
	return b, label
end

local function smallButton(text, pos, size, color, parent)
	local b = make("TextButton", {
		Size = size, Position = pos, BackgroundColor3 = color, BorderSizePixel = 0,
		Font = Enum.Font.GothamBold, Text = text, TextColor3 = Color3.new(1, 1, 1), TextSize = 12,
		AutoButtonColor = false,
	}, parent)
	corner(8, b)
	b.MouseEnter:Connect(function()
		TS:Create(b, TweenInfo.new(0.12), { BackgroundColor3 = color:Lerp(Color3.new(1,1,1), 0.18) }):Play()
	end)
	b.MouseLeave:Connect(function()
		TS:Create(b, TweenInfo.new(0.12), { BackgroundColor3 = color }):Play()
	end)
	return b
end

