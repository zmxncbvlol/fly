--------------------------------------------------------------------
local function updateProgress()
	local frac = 0
	if #CONFIG.Waypoints > 0 then frac = currentIdx / #CONFIG.Waypoints end
	frac = math.clamp(frac, 0, 1)
	TS:Create(progFill, TweenInfo.new(0.25), { Size = UDim2.new(frac, 0, 1, 0) }):Play()
end

local function refreshButtons()
	local th = THEMES[CONFIG.Theme]
	if farming then
		TS:Create(ui.farmBtn, TweenInfo.new(0.2), { BackgroundColor3 = th.red }):Play()
		ui.farmLabel.Text = "STOP FARMING"
	else
		TS:Create(ui.farmBtn, TweenInfo.new(0.2), { BackgroundColor3 = th.green }):Play()
		ui.farmLabel.Text = "START FARMING"
	end
	ui.loopBtn.Text = CONFIG.Loop and "LOOP ON" or "LOOP OFF"
	TS:Create(loopDot, TweenInfo.new(0.15), { BackgroundColor3 = CONFIG.Loop and th.green or Color3.fromRGB(110,110,120) }):Play()
	ui.speedValue.Text = tostring(math.floor(CONFIG.Speed))
end

local function stopFarm()
	farming = false
	runId += 1
	currentIdx = 0
	setStatus("Idle")
	updateProgress()
	refreshButtons()
end

local function startFarm()
	if farming then return end
	farming, laps, startTime, currentIdx = true, 0, os.clock(), 0
	runId += 1
	local myId = runId
	refreshButtons()
	local function isActive() return farming and runId == myId end

	task.spawn(function()
		while isActive() do
			for i, point in ipairs(CONFIG.Waypoints) do
				if not isActive() then break end
				if not getCharacter() then
					setStatus("캐릭터 대기 중...")
					task.wait(0.3)
					break
				end
				currentIdx = i
				updateProgress()
				setStatus(("이동 중 · %d / %d"):format(i, #CONFIG.Waypoints),
					("Laps %d   •   %s"):format(laps, fmtTime(os.clock() - startTime)))
				if flyTo(point, isActive) then task.wait(CONFIG.PointDelay) end
			end
			if isActive() then
				laps += 1
				currentIdx = 0
				updateProgress()
				if not CONFIG.Loop then break end
			end
			task.wait()
		end
		if runId == myId then
			farming = false
			setStatus("완료", ("Laps %d   •   %s"):format(laps, fmtTime(os.clock() - startTime)))
			refreshButtons()
		end
	end)
end

local function goToCenter()
	stopFarm()
	local myId = runId
	task.spawn(function()
		local ok = flyTo(CONFIG.Center, function() return runId == myId end, true)
		if runId == myId then setStatus(ok and "중앙에 도착" or "Idle") end
	end)
end

local function updateSliderVisual()
	local frac = (CONFIG.Speed - CONFIG.MinSpeed) / (CONFIG.MaxSpeed - CONFIG.MinSpeed)
	frac = math.clamp(frac, 0, 1)
	sliderFill.Size = UDim2.new(frac, 0, 1, 0)
	sliderKnob.Position = UDim2.new(frac, -8, 0.5, -8)
	ui.speedValue.Text = tostring(math.floor(CONFIG.Speed))
end

task.spawn(function()
	while true do
		if farming then
			TS:Create(statusDot, TweenInfo.new(0.6, Enum.EasingStyle.Sine), { BackgroundTransparency = 0.65 }):Play()
			task.wait(0.6)
			TS:Create(statusDot, TweenInfo.new(0.6, Enum.EasingStyle.Sine), { BackgroundTransparency = 0 }):Play()
			task.wait(0.6)
		else
			statusDot.BackgroundTransparency = 0
			task.wait(0.2)
		end
	end
end)

